{
  "name": "phaser4-msdf-text",
  "version": "0.3.0",
  "description": "MSDF (Multi-channel Signed Distance Field) font rendering plugin for Phaser 4",
  "type": "module",
  "main": "./dist/phaser4-msdf-text.cjs",
  "module": "./dist/phaser4-msdf-text.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/phaser4-msdf-text.js",
      "require": "./dist/phaser4-msdf-text.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "FONTS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/phaser4-msdf-text.js",
    "./dist/phaser4-msdf-text.cjs",
    "./src/index.ts",
    "./src/MSDFTextFactory.ts",
    "./src/MSDFTextCreator.ts",
    "./src/MSDFFontFile.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:examples": "vite build --mode examples",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "phaser",
    "phaser4",
    "msdf",
    "font",
    "text",
    "rendering",
    "webgl",
    "sdf",
    "signed-distance-field"
  ],
  "author": "Peter Achberger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antriel/phaser4-msdf-text.git"
  },
  "bugs": {
    "url": "https://github.com/Antriel/phaser4-msdf-text/issues"
  },
  "homepage": "https://antriel.github.io/phaser4-msdf-text/",
  "peerDependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^20.10.0",
    "phaser": "^4.1.0",
    "phaser3spectorjs": "^0.0.8",
    "tweakpane": "^4.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
